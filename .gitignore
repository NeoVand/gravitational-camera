# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/

# Node (the app has its own .gitignore as well)
node_modules/

# OS
.DS_Store

# LaTeX build output; the PDF is built in CI and published with the site
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/main.pdf
app/static/gravitational-camera.pdf

# drafts of the tutorial's figures (figures3d/render.mjs --tutorial)
tutorial/figures/staging/
tutorial/figures/book/staging/
# render.mjs writes a PDF beside each drawing; the site and the book read the SVG
tutorial/figures/*.pdf
tutorial/figures/book/*.pdf

# scratch files that agents leave at the root
/scratchpad/

# the book PDF: build/ is the cache and intermediate files, out/ the finished book
book/build/
book/out/

# the paper as it is sent to a journal or arXiv (paper/make_submission.py)
paper/submission/
paper/submission.tar.gz
paper/submission.pdf
